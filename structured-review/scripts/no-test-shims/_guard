#!/bin/sh
# Reviewer-process guard: tests never run on this machine (CI/rx only).
# Tools that only run tests are always blocked; uv/npm/npx/pnpm/yarn are blocked
# only when the arguments look like a test run, otherwise they pass through.
name=$(basename "$0")
deny() { echo "tests run in CI/rx only ($name blocked by structured-review guard; cite CI evidence instead)" >&2; exit 1; }
case "$name" in
  uv|npm|npx|pnpm|yarn)
    case " $* " in
      *pytest*|*" test "*|*vitest*|*playwright*|*" vite "*|*light_checks*|*promtool*) deny ;;
    esac
    here=$(cd "$(dirname "$0")" && pwd)
    PATH=$(printf %s "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
    export PATH
    exec "$name" "$@"
    ;;
  *) deny ;;
esac
